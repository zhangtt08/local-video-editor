{
  "name": "agentcut-desktop",
  "version": "1.153.0",
  "private": true,
  "description": "AgentCut 桌面剪辑台（为 Agent 而生的本地剪辑软件）",
  "author": "AgentCut",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite build --mode development && npm run esbuild && electron .",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "esbuild": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --sourcemap",
    "build": "npm run build:renderer && npm run esbuild",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.agentcut.desktop",
    "productName": "AgentCut",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "AgentCut-便携版.exe"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "AgentCut-安装版.exe",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "createDesktopShortcut": true,
      "shortcutName": "AgentCut 剪辑台"
    }
  }
}
